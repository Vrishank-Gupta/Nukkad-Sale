{
  "name": "khatakhat",
  "version": "0.1.0",
  "private": true,
  "description": "Flash drops, UPI checkout, live stock and a digital khata for WhatsApp community sellers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply khatakhat --local",
    "db:migrate:remote": "wrangler d1 migrations apply khatakhat --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.13.13",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "typescript": "5.9.3",
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
